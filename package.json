{
  "name": "nch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b tsconfig.app.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "signaling:test": "vitest run --config server/vitest.config.ts --passWithNoTests",
    "signaling:dev": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "signaling:start": "tsx --tsconfig server/tsconfig.json server/main.ts",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write",
      "vitest run --reporter=verbose --passWithNoTests"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "express": "^4.18.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reconnecting-websocket": "^4.4.0",
    "tailwindcss": "^4.2.2",
    "ws": "^8.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "tsx": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.4"
  }
}
